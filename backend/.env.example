# PersonaOS Environment Configuration
# This file is used for local development OUTSIDE of Docker.
# Docker Compose overrides these values via the environment section.

# Application
APP_NAME=PersonaOS
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# Security
SECRET_KEY=your-super-secret-key-change-in-production
JWT_EXPIRE_MINUTES=30

# Database (local development - when running outside Docker)
DATABASE_URL=postgresql+asyncpg://postgres:1234@localhost:5433/personaos
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis (local development - when running outside Docker)
REDIS_URL=redis://localhost:6380/0

# Superuser (seeded on first startup)
SUPERUSER_EMAIL=admin@personaos.com
SUPERUSER_PASSWORD=change-me-in-production

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console
